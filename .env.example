# Copy this file to .env and fill in the values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID (General Information page)
CLIENT_ID=

# Your server's ID (right-click server icon -> Copy Server ID, needs Developer Mode on)
GUILD_ID=

# Channel where claim messages get posted
CLAIM_CHANNEL_ID=

# Role that gets pinged on each claim
STAFF_ROLE_ID=
